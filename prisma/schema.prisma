generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(cuid())
  name            String?
  email           String         @unique
  password        String?
  role            Role           @default(USER)
  createdAt       DateTime       @default(now())
  accounts        Account[]
  sessions        Session[]
  ticketsAssigned Ticket[]       @relation("TicketsAssigned")
  ticketsCreated  Ticket[]       @relation("TicketsCreated")
  updates         TicketUpdate[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Ticket {
  id                      String         @id @default(cuid())
  ticketId                Int            @default(autoincrement())
  title                   String
  description             String
  imageDataUrl            String?
  location                String
  category                String
  priority                String
  status                  TicketStatus   @default(OPEN)
  aiSummary               String
  aiKeywords              String[]
  aiFixSteps              String[]
  technicianType          String?
  predictedResolutionTime Int
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  createdById             String
  assignedToId            String?
  assignedTo              User?          @relation("TicketsAssigned", fields: [assignedToId], references: [id])
  createdBy               User           @relation("TicketsCreated", fields: [createdById], references: [id])
  updates                 TicketUpdate[]
}

model TicketUpdate {
  id              String        @id @default(cuid())
  ticketId        String
  updatedById     String
  message         String
  statusChangedTo TicketStatus?
  createdAt       DateTime      @default(now())
  ticket          Ticket        @relation(fields: [ticketId], references: [id])
  updatedBy       User          @relation(fields: [updatedById], references: [id])
}

enum Role {
  USER
  ADMIN
  TECHNICIAN
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}
